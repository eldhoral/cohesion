---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Area } from '../data/types.ts';
import type { Locale } from '../i18n/index.ts';

export interface Props { area: Area; lang: Locale; image?: ImageMetadata; tone?: 'navy' | 'teal' }
const { area, lang, image, tone = 'navy' } = Astro.props as Props;
---
<article class:list={['focus', { 'focus--solid': !image }, `focus--${tone}`]} data-focus={area.slug} data-solid={image ? undefined : ''}>
  {image && <Image class="focus__img photo-bw" src={image} alt="" widths={[480, 800]} sizes="(min-width: 60rem) 30vw, 90vw" loading="lazy" />}
  <div class="focus__body">
    <span class="focus__bar" aria-hidden="true"></span>
    <h3>{area.name[lang]}</h3>
    <p>{area.blurb[lang]}</p>
  </div>
</article>
<style>
  .focus { position: relative; isolation: isolate; overflow: hidden; border-radius: var(--radius); min-height: 17rem; display: flex; align-items: flex-end; color: #fff; background: var(--navy-deep); transition: transform 0.3s var(--ease); }
  .focus:hover { transform: translateY(-4px); }
  .focus--teal { background: var(--teal); }
  .focus__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 0.6s var(--ease); }
  .focus:hover .focus__img { transform: scale(1.05); }
  .focus:not(.focus--solid)::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(18 48 79 / 0.92) 15%, rgb(18 48 79 / 0.2)); }
  .focus__body { padding: 1.5rem; }
  .focus__bar { display: block; width: 2rem; height: 3px; background: var(--yellow); margin-bottom: 0.75rem; }
  .focus h3 { color: #fff; margin-bottom: 0.35rem; }
  .focus p { margin: 0; font-size: var(--step-small); }
</style>
