---
import type { Advisor } from '../data/types.ts';
import type { Locale } from '../i18n/index.ts';
import { initials } from '../data/initials.ts';

const { advisor, lang } = Astro.props as { advisor: Advisor; lang: Locale };
const initial = initials(advisor.name);
---
<article class="advisor" data-advisor>
  <span class="advisor__avatar" aria-hidden="true">{initial}</span>
  <div>
    <h3>{advisor.name}</h3>
    {advisor.roles[lang].map((r) => <p>{r}</p>)}
  </div>
</article>
<style>
  .advisor { display: flex; gap: 1rem; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; height: 100%; }
  .advisor__avatar { flex: none; width: 3rem; height: 3rem; border-radius: 50%; background: var(--teal); color: #fff; display: grid; place-items: center; font: 700 1rem var(--font-head); }
  .advisor h3 { font-size: 1.0625rem; margin-bottom: 0.4rem; overflow-wrap: anywhere; }
  .advisor p { margin: 0 0 0.25rem; color: var(--muted); font-size: var(--step-small); line-height: 1.45; overflow-wrap: anywhere; }
</style>
