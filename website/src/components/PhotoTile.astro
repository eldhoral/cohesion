---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type TileKey = 'wheat' | 'rice' | 'salt' | 'leaf' | 'plate' | 'school';
export interface Props { tile: TileKey; image: ImageMetadata; alt: string }
const { tile, image, alt } = Astro.props as Props;
---
<li class="tile" data-tile={tile}>
  <Image class="tile__img" src={image} alt={alt} widths={[320, 640]} sizes="(min-width: 60rem) 22vw, 45vw" loading="lazy" />
</li>
<style>
  .tile { position: relative; overflow: hidden; border-radius: var(--radius); box-shadow: var(--shadow); background: var(--mist); transition: transform 0.25s var(--ease); }
  .tile:hover { transform: translateY(-3px); }
  .tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
</style>
