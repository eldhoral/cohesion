---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type TileKey = 'wheat' | 'rice' | 'salt' | 'leaf' | 'plate' | 'school';
export interface Props { tile: TileKey; image: ImageMetadata; label: string }
const { tile, image, label } = Astro.props as Props;
---
<li class="tile" data-tile={tile}>
  <Image class="tile__img photo-bw" src={image} alt="" widths={[240, 480]} sizes="(min-width: 60rem) 14vw, 30vw" loading="lazy" />
  <span class="tile__label">{label}</span>
</li>
<style>
  .tile { position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 4 / 3; box-shadow: var(--shadow); background: var(--navy-deep); isolation: isolate; transition: transform 0.25s var(--ease); }
  .tile:hover { transform: translateY(-3px); }
  .tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .tile::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgb(18 48 79 / 0.9) 0%, rgb(18 48 79 / 0.25) 55%, transparent); }
  .tile__label { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.75rem; font: 700 var(--step-small) / 1.2 var(--font-head); color: #fff; text-align: left; }
</style>
