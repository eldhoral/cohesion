---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type TileKey = 'wheat' | 'rice' | 'salt' | 'leaf' | 'plate' | 'school';
export interface Props { tile: TileKey; image: ImageMetadata; label: string }
const { tile, image, label } = Astro.props as Props;
---
<li class="tile" data-tile={tile}>
  <Image class="tile__img" src={image} alt="" widths={[320, 640]} sizes="(min-width: 60rem) 22vw, 45vw" loading="lazy" />
  <span class="tile__label">{label}</span>
</li>
<style>
  .tile { position: relative; overflow: hidden; border-radius: var(--radius); box-shadow: var(--shadow); background: var(--mist); transition: transform 0.25s var(--ease); }
  .tile:hover { transform: translateY(-3px); }
  .tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tile__label { position: absolute; left: 0.75rem; bottom: 0.75rem; max-width: calc(100% - 1.5rem); padding: 0.35rem 0.8rem; border-radius: 99px; background: #fff; color: var(--navy-deep); font: 700 var(--step-small) / 1.2 var(--font-head); }
</style>
