---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { localePath, t, type Locale } from '../i18n/index.ts';

export interface Props {
  lang: Locale;
  slides: { image: ImageMetadata; tag: string; title: string; text: string }[];
}
const { lang, slides } = Astro.props as Props;
const d = t(lang);
const label = (n: number) => d.home.slideOf.replace('{n}', String(n)).replace('{total}', String(slides.length));
---
<section class="slider" aria-roledescription={d.home.roleCarousel} aria-label={d.home.carousel}>
  <div class="slides">
    {slides.map((s, i) => (
      <div
        class:list={['slide', { 'is-active': i === 0 }]}
        data-slide
        role="group"
        aria-roledescription={d.home.roleSlide}
        aria-label={label(i + 1)}
        aria-hidden={i === 0 ? undefined : 'true'}>
        <Image class="slide__img photo-bw" src={s.image} alt="" widths={[800, 1400, 2200]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} />
        <div class="slide__shade"></div>
        <div class="container slide__body">
          <span class="tag">{s.tag}</span>
          <h2 class="slide__title">{s.title}</h2>
          <p class="slide__text">{s.text}</p>
          <div class="slide__actions">
            <a class="btn btn--yellow" href={localePath(lang, '/our-work/')}>{d.home.exploreWork}</a>
            <a class="btn btn--ghost" href={localePath(lang, '/contact/')}>{d.home.partner}</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="container controls">
    <button class="ctl" type="button" data-prev aria-label={d.home.prev}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <button class="ctl" type="button" data-next aria-label={d.home.next}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
    <div class="dots">
      {slides.map((_, i) => (
        <button class="dot" type="button" data-dot={i} aria-label={label(i + 1)} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .slider { position: relative; background: var(--navy-deep); color: #fff; }
  .slides { display: grid; }
  .slide {
    grid-area: 1 / 1; position: relative; isolation: isolate; overflow: hidden;
    min-height: clamp(30rem, 62vh, 40rem); display: flex; align-items: center;
    padding-block: 4rem 6rem;
    opacity: 0; visibility: hidden;
    transition: opacity 0.7s var(--ease), visibility 0s linear 0.7s;
  }
  .slide.is-active { opacity: 1; visibility: visible; transition: opacity 0.7s var(--ease), visibility 0s; }
  .slide__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; z-index: -2; opacity: 0.6; }
  .slide__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(18 48 79 / 0.95) 10%, rgb(18 48 79 / 0.55) 60%, rgb(18 48 79 / 0.3)); }
  .slide__body { max-width: var(--max); }
  .tag { display: inline-block; background: var(--yellow); color: var(--navy-deep); font: 700 var(--step-eyebrow) var(--font-head); padding: 0.4rem 0.9rem; border-radius: 99px; margin-bottom: 1.25rem; }
  .slide__title { font: 800 var(--step-h1) / 1.08 var(--font-head); color: #fff; max-width: 40rem; margin: 0 0 1rem; text-wrap: balance; }
  .slide__text { max-width: 34rem; font-size: 1.1875rem; margin-bottom: 1.75rem; }
  .slide__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .controls { position: absolute; left: 50%; transform: translateX(-50%); bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem; z-index: 2; }
  .ctl { width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 2px solid #fff; background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; transition: background-color 0.2s, color 0.2s; }
  .ctl:hover { background: #fff; color: var(--navy-deep); }
  .dots { display: flex; gap: 0.25rem; margin-left: 0.5rem; }
  .dot { position: relative; width: 2.75rem; height: 2.75rem; border: 0; background: transparent; cursor: pointer; }
  .dot::before { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 0.75rem; transform: translate(-50%, -50%); border-radius: 99px; background: rgb(255 255 255 / 0.55); transition: width 0.3s var(--ease), background-color 0.3s; }
  .dot[aria-current='true']::before { width: 2rem; background: var(--yellow); }
  @media (prefers-reduced-motion: reduce) { .slide, .slide.is-active { transition: opacity 0.2s linear; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.slider').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    let current = 0;
    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        s.classList.toggle('is-active', on);
        if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');
        s.toggleAttribute('inert', !on);
      });
      dots.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    slides.forEach((s, i) => s.toggleAttribute('inert', i !== 0));
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    root.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'ArrowLeft') show(current - 1);
      if ((e as KeyboardEvent).key === 'ArrowRight') show(current + 1);
    });
  });
</script>
