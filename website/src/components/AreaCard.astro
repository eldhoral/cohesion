---
import type { Area } from '../data/types.ts';
import type { Locale } from '../i18n/index.ts';
const { area, lang } = Astro.props as { area: Area; lang: Locale };
---
<article class="area" data-area={area.slug}>
  <span class="area__n">{String(area.n).padStart(2, '0')}</span>
  <h3>{area.name[lang]}</h3>
  <p>{area.blurb[lang]}</p>
</article>
<style>
  .area { background: #fff; border-radius: var(--radius); border-top: 4px solid var(--yellow); padding: 1.5rem; box-shadow: var(--shadow); transition: transform 0.25s var(--ease), box-shadow 0.25s; height: 100%; }
  .area:hover { transform: translateY(-4px); }
  .area__n { display: block; font: 800 1.75rem var(--font-head); color: var(--teal); margin-bottom: 0.5rem; }
  .area h3 { margin-bottom: 0.4rem; }
  .area p { margin: 0; color: var(--muted); font-size: var(--step-small); }
</style>
