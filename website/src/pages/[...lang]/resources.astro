---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { publications } from '../../data/publications.ts';
import { config } from '../../config.ts';
import { localePath, t, type Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'id' } }];
}

const lang: Locale = Astro.params.lang === 'id' ? 'id' : 'en';
const d = t(lang);
const r = d.resources;
// ponytail: grouped list, no filter tabs; add tabs when there are enough publications to need them
const groups = (['report', 'brief', 'note'] as const)
  .map((type) => ({ type, items: publications.filter((p) => p.type === type) }))
  .filter((g) => g.items.length);
---
<Base title={r.title} description={r.description}>
  <PageHero lang={lang} title={r.title} subtitle={r.subtitle} />

  <section class="section">
    <div class="container">
      {publications.length === 0 ? (
        <div class="empty" data-empty>
          <span class="empty__icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></svg>
          </span>
          <h2>{r.empty.title}</h2>
          <p>{r.empty.text}</p>
          {config.linkedin ? (
            <>
              <p>{r.empty.linkedin}</p>
              <a class="btn btn--teal" href={config.linkedin} rel="noopener">{d.common.followLinkedIn}</a>
            </>
          ) : (
            <>
              <p>{r.empty.contact}</p>
              <a class="btn btn--teal" href={localePath(lang, '/contact/')}>{r.empty.contactButton}</a>
            </>
          )}
        </div>
      ) : (
        groups.map((g) => (
          <div class="group">
            <h2>{r.types[g.type]}</h2>
            <ul>
              {g.items.map((p) => (
                <li><a href={p.file} download>{p.title[lang]}</a> <span>· {r.download}</span></li>
              ))}
            </ul>
          </div>
        ))
      )}
    </div>
  </section>
</Base>

<style>
  .empty { max-width: 44rem; margin-inline: auto; text-align: center; background: var(--mist); border-top: 4px solid var(--yellow); border-radius: var(--radius); padding: clamp(2rem, 6vw, 3.5rem) 1.5rem; }
  .empty__icon { display: inline-grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: var(--navy-deep); color: var(--yellow); margin-bottom: 1rem; }
  .empty h2 { font-size: 1.75rem; }
  .empty p { margin-inline: auto; max-width: 30rem; }
  .group ul { padding-left: 1.25rem; }
</style>
