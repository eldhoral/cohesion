---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import PhotoTile from '../../../components/PhotoTile.astro';
import PersonCard from '../../../components/PersonCard.astro';
import AdvisorCard from '../../../components/AdvisorCard.astro';
import { teamGroups } from '../../../data/people.ts';
import { advisors } from '../../../data/advisors.ts';
import { photo } from '../../../data/images.ts';
import { t, type Locale } from '../../../i18n/index.ts';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'id' } }];
}

const lang: Locale = Astro.params.lang === 'id' ? 'id' : 'en';
const d = t(lang);
const a = d.about;
const hero = photo('aboutHero');
const tiles = ([
  ['wheat', 'tileWheat'],
  ['rice', 'tileRice'],
  ['salt', 'tileSalt'],
  ['leaf', 'tileLeaf'],
  ['plate', 'tilePlate'],
  ['school', 'tileSchool'],
] as const).map(([tile, key]) => ({ tile, image: photo(key).src, alt: photo(key).alt[lang] }));
---
<Base title={a.title} description={a.description}>
  <PageHero lang={lang} title={a.title} subtitle={a.subtitle} image={hero.src} />

  <section class="section">
    <div class="container bg">
      <div>
        <Eyebrow>{a.bg.eyebrow}</Eyebrow>
        <h2>{a.bg.title}</h2>
        <p>{a.bg.p1}</p>
        <p>{a.bg.p2}</p>
      </div>
      <div>
        <ul class="tiles" aria-label={a.tilesLabel}>
          {tiles.map((x) => <PhotoTile tile={x.tile} image={x.image} alt={x.alt} />)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section team-intro" id="team">
    <div class="container">
      <Eyebrow>{d.team.title}</Eyebrow>
      <h2>{a.team.title}</h2>
      <p class="lead">{a.team.text}</p>
    </div>
  </section>

  {teamGroups.map((g, i) => (
    <section class:list={['section', 'group', { 'group--alt': i % 2 === 0 }]} data-group={g.key}>
      <div class="container">
        <h3 class="group__title">{g.title[lang]}</h3>
        {g.key === 'advisors' ? (
          <div class="advisors">
            {advisors.map((x) => <AdvisorCard advisor={x} lang={lang} />)}
          </div>
        ) : (
          <div class="people">
            {g.people?.map((p) => <PersonCard person={p} lang={lang} />)}
          </div>
        )}
      </div>
    </section>
  ))}
</Base>

<style>
  .bg { display: grid; gap: clamp(2rem, 6vw, 4rem); align-items: start; }
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; grid-template-columns: 1fr 1fr; grid-auto-rows: 4.25rem; }
  .tiles :global(.tile:nth-child(1)) { grid-column: 1; grid-row: 1 / 4; }
  .tiles :global(.tile:nth-child(2)) { grid-column: 2; grid-row: 1 / 3; }
  .tiles :global(.tile:nth-child(3)) { grid-column: 1; grid-row: 4 / 6; }
  .tiles :global(.tile:nth-child(4)) { grid-column: 2; grid-row: 3 / 6; }
  .tiles :global(.tile:nth-child(5)) { grid-column: 1; grid-row: 6 / 9; }
  .tiles :global(.tile:nth-child(6)) { grid-column: 2; grid-row: 6 / 9; }
  @media (min-width: 60rem) { .tiles { grid-auto-rows: 5rem; } }
  .lead { color: var(--muted); max-width: 40rem; margin: 0; }
  .team-intro { scroll-margin-top: 5rem; padding-bottom: 2.5rem; }
  .group--alt { background: var(--mist); }
  .group__title { margin: 0 0 2rem; }
  .people { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr)); }
  .advisors { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  @media (min-width: 60rem) { .bg { grid-template-columns: 1fr 1fr; } }
</style>
