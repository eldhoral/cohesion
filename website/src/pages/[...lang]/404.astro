---
import Base from '../../layouts/Base.astro';
import { localePath, t, type Locale } from '../../i18n/index.ts';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'id' } }];
}

const lang: Locale = Astro.params.lang === 'id' ? 'id' : 'en';
const n = t(lang).notFound;
---
<Base title={n.title} description={n.text}>
  <section class="section">
    <div class="container nf">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>{n.title}</h1>
      <p>{n.text}</p>
      <a class="btn btn--teal" href={localePath(lang, '/')}>{n.back}</a>
    </div>
  </section>
</Base>
<style>
  .nf { min-height: 45vh; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .nf__code { font: 800 clamp(4rem, 12vw, 8rem) / 1 var(--font-head); color: var(--yellow); margin: 0; }
</style>
